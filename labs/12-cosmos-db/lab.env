# =============================================================================
# Lab 12 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# =============================================================================

RG="$(rg_name 12)"                    # rg-lunch12-<suffix>
ACCOUNT="${LAB12_ACCOUNT:-cosmos-nusa-${SUFFIX}}"   # global name: 3–44 lowercase letters, digits, hyphens
DATABASE="catalog"
CONTAINER="products"
PARTITION_KEY="/category"
DATA_ROLE="Cosmos DB Built-in Data Contributor"   # built-in data-plane role, looked up by name

# The Python scripts in app/ read these variables
export COSMOS_ENDPOINT="https://${ACCOUNT}.documents.azure.com:443/"
export COSMOS_DATABASE="$DATABASE"
export COSMOS_CONTAINER="$CONTAINER"
