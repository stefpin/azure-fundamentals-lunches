# =============================================================================
# Lab 17 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# =============================================================================

RG="$(rg_name 17)"                        # rg-lunch17-<suffix>

# Starting point (created by setup.sh)
VNET="vnet-nusa-orders"                   # 10.17.0.0/16
SUBNET="snet-orders"                      # 10.17.1.0/24, private subnet (no default outbound access)
NSG="nsg-orders"                          # no inbound rules: nothing from the internet reaches the VM
NIC="nic-vm-orders"
VM="vm-orders"                            # Ubuntu, no public IP; holds /data/orders.csv

# What you build in the tasks
VAULT="rsv-nusa"                          # Recovery Services vault
POLICY="DefaultPolicy"                    # built-in VM policy: daily backup, 30-day retention
STAGING="${LAB17_STAGING:-stnusarestore${SUFFIX}}"   # storage account the restore job uses (same region as the vault)

# Runs a command or a script file inside the VM through the Azure VM agent (no SSH, no public IP needed).
# Each call takes 20-60 seconds.   Examples:  vm_run "ls -l /data"     vm_run @vm/check-orders.sh
vm_run() {
  az vm run-command invoke -g "$RG" -n "$VM" --command-id RunShellScript \
    --scripts "$@" --query "value[0].message" --output tsv
}
