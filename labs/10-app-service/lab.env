# =============================================================================
# Lab 10 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# =============================================================================

RG="$(rg_name 10)"                                  # rg-lunch10-<suffix>
PLAN="asp-nusa-${SUFFIX}"                           # Linux App Service plan (F1; S1 for the stretch)

# The web app name must be unique across all of Azure. If yours is taken, run
#     export LAB10_APP="app-nusa-${SUFFIX}2"
# and source this file again.
APP="${LAB10_APP:-app-nusa-${SUFFIX}}"

# Built-in runtime stack. List the current ones with:
#     az webapp list-runtimes --os-type linux --output table | grep -i python
RUNTIME="${LAB10_RUNTIME:-PYTHON:3.12}"

STORE="Nusantara Retail - Kemang"                   # value for the STORE_NAME app setting
OUT_DIR="${HOME}/lab10-out"                         # zip packages are built here, outside the repo
