# =============================================================================
# Lab 27 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# =============================================================================

RG="$(rg_name 27)"                      # rg-lunch27-<suffix>

# Starting point (created by setup.sh)
PLAN="asp-nusa-edge"                    # App Service plan (Windows)
APP_SKU="${APP_SKU:-F1}"                # Free tier; set APP_SKU=B1 before setup.sh if F1 is refused
APP_STORE="app-nusa-store-${SUFFIX}"    # storefront app
APP_IMG="app-nusa-img-${SUFFIX}"        # images app (also the standby endpoint for Traffic Manager)
VNET="vnet-nusa-edge"                   # 10.27.0.0/16
SUBNET_AGW="snet-agw"                   # 10.27.0.0/24, dedicated to Application Gateway

# What you build in the tasks
WAF_POLICY="waf-nusa"                   # WAF policy (Microsoft Default Rule Set)
PIP_AGW="pip-agw-nusa"                  # Standard public IP for the gateway
AGW="agw-nusa"                          # Application Gateway, WAF_v2
PROBE_AGW="probe-app"                   # custom health probe for App Service backends
POOL_IMG="pool-images"                  # backend pool for the images app
PATH_MAP="urlmap-nusa"                  # URL path map: /images/* -> pool-images
TM_PROFILE="tm-nusa"                    # Traffic Manager profile
TM_DNS="nusa-shop-${SUFFIX}"            # -> nusa-shop-<suffix>.trafficmanager.net
AFD_PROFILE="afd-nusa"                  # optional: Front Door Standard profile
AFD_ENDPOINT="fde-nusa-${SUFFIX}"       # optional: Front Door endpoint

# load_hosts  -> sets STORE_HOST and IMG_HOST (the apps' default host names) and prints them
load_hosts() {
  STORE_HOST="$(az webapp show -g "$RG" -n "$APP_STORE" --query defaultHostName --output tsv 2>/dev/null || true)"
  IMG_HOST="$(az webapp show -g "$RG" -n "$APP_IMG" --query defaultHostName --output tsv 2>/dev/null || true)"
  export STORE_HOST IMG_HOST
  echo "STORE_HOST=${STORE_HOST:-<not found — run setup.sh>}"
  echo "IMG_HOST=${IMG_HOST:-<not found — run setup.sh>}"
}

# gw_ip  -> prints the Application Gateway's public IP address (empty if it does not exist yet)
gw_ip() { az network public-ip show -g "$RG" -n "$PIP_AGW" --query ipAddress --output tsv 2>/dev/null || true; }

# tm_watch [rounds]  -> every 10 s: endpoint health in Traffic Manager and the current DNS answer
tm_watch() {
  local n="${1:-6}" i health answer
  for ((i = 1; i <= n; i++)); do
    health="$(az network traffic-manager endpoint list -g "$RG" --profile-name "$TM_PROFILE" \
      --query "[].[name, endpointMonitorStatus]" --output tsv 2>/dev/null | tr '\t\n' ': ' || true)"
    answer="$(dig +short "${TM_DNS}.trafficmanager.net" 2>/dev/null | head -n1 || true)"
    printf '%s  %s DNS answer → %s\n' "$(date +%T)" "${health:-<no endpoints>}" "${answer:-<none>}"
    if ((i < n)); then sleep 10; fi
  done
}
