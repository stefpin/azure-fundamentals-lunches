# =============================================================================
# Lab 21 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# The names match infra/main.bicep and its modules. If you build the platform
# your own way (Challenge mode), use these names so verify.sh can find things.
# =============================================================================

RG="$(rg_name 21)"                  # rg-lunch21-<suffix>
DEPLOYMENT="capstone"               # name of the resource group deployment (deploy.sh)

# Network (modules/network.bicep)
VNET="vnet-nusa-capstone"           # 10.21.0.0/16
WEB_SUBNET="snet-web"               # 10.21.1.0/24, private subnet
DATA_SUBNET="snet-data"             # 10.21.2.0/24, reserved for private endpoints
NSG="nsg-web"                       # allows TCP 80 from Internet and AzureLoadBalancer

# Web tier (modules/web.bicep)
PIP="pip-nusa-shop"                 # zone-redundant Standard public IP
LB="lb-nusa-shop"                   # Standard public load balancer
VM1="vm-web-1"                      # availability zone 1, no public IP
VM2="vm-web-2"                      # availability zone 2, no public IP

# Data and secrets (modules/sql.bicep, modules/keyvault.bicep)
SQL="sql-nusa-${SUFFIX}"            # logical server, Microsoft Entra-only authentication
DB="sqldb-orders"                   # serverless database (free offer by default)
KV="kv-nusa-${SUFFIX}"              # Key Vault, Azure RBAC permission model
SECRET="sql-connection-string"      # example secret (contains no password)

# Operations and governance (modules/monitoring.bicep, modules/policy.bicep)
LAW="log-nusa"                      # Log Analytics workspace
AG="ag-nusa-oncall"                 # action group (e-mail)
POLICY_ASSIGNMENT="allowed-locations"
BUDGET="budget-lunch21"             # created in the portal in Task 7

# lb_ip  -> prints the storefront's public IP address (empty if it does not exist yet)
lb_ip() { az network public-ip show -g "$RG" -n "$PIP" --query ipAddress --output tsv 2>/dev/null; }

# who_answers [count]  -> sends requests to the storefront and prints which VM answered each one
who_answers() {
  local ip n="${1:-10}" i out
  ip="$(lb_ip)"
  if [[ -z "$ip" ]]; then echo "No public IP yet. Run 'bash deploy.sh' first."; return 1; fi
  for ((i = 1; i <= n; i++)); do
    out="$(curl -s --max-time 3 "http://${ip}/" | grep -o 'Served by.*</p>' | sed 's/<[^>]*>//g')"
    echo "${i}. ${out:-(no answer)}"
    sleep 1
  done
}

# watch_shop [seconds]  -> every 2 seconds, prints the time and which VM answered (default: 2 minutes)
watch_shop() {
  local ip end host
  ip="$(lb_ip)"
  if [[ -z "$ip" ]]; then echo "No public IP yet. Run 'bash deploy.sh' first."; return 1; fi
  end=$((SECONDS + ${1:-120}))
  while (( SECONDS < end )); do
    host="$(curl -s --max-time 2 "http://${ip}/" | grep -oE 'vm-web-[0-9]+' | head -n1)"
    printf '%s  %s\n' "$(date +%T)" "${host:-(no answer)}"
    sleep 2
  done
}
