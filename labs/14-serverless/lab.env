# =============================================================================
# Lab 14 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# =============================================================================

RG="$(rg_name 14)"                                  # rg-lunch14-<suffix>

# Starting point (created by setup.sh)
ST="${LAB14_ST:-stnusaorders${SUFFIX}}"             # storage account: function host storage + the orders queue
QUEUE="orders"                                      # the queue the function writes to
LAW="log-nusa"                                      # Log Analytics workspace behind Application Insights

# What you build in the tasks
FUNC="${LAB14_FUNC:-func-nusa-${SUFFIX}}"           # function app on Flex Consumption (globally unique name)
PY_VERSION="${LAB14_PY_VERSION:-3.12}"              # Python version of the function app
CONNECTION="OrdersStorage"                          # connection name used in function/function_app.py
LOGIC="logic-nusa-orders"                           # Consumption Logic App that sends a heartbeat order

OUT_DIR="${HOME}/lab14-out"                         # zip package and the filled-in workflow (it holds a key) live here
