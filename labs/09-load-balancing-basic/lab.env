# =============================================================================
# Lab 09 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# =============================================================================

RG="$(rg_name 09)"              # rg-lunch09-<suffix>

# Starting point (created by setup.sh)
VNET="vnet-nusa-web"            # 10.9.0.0/16
SUBNET="snet-web"               # 10.9.1.0/24, private subnet (no default outbound access)
NSG="nsg-web"                   # allows TCP 80 from Internet and from AzureLoadBalancer
VM1="vm-web-1"                  # availability zone 1, no public IP
VM2="vm-web-2"                  # availability zone 2, no public IP
NIC1="nic-vm-web-1"
NIC2="nic-vm-web-2"
IPCONFIG="ipconfig1"            # IP configuration name on both NICs

# What you build in the tasks
PIP="pip-lb-nusa-web"           # zone-redundant Standard public IP
LB="lb-nusa-web"                # Standard public load balancer
FE="fe-web"                     # frontend IP configuration
POOL="be-web"                   # backend pool (NIC-based)
PROBE="probe-http"              # HTTP health probe on /health
RULE="rule-http"                # load-balancing rule TCP 80 -> 80
NAT_RULE="nat-ssh-vm1"          # inbound NAT rule 50001 -> vm-web-1:22
NAT_PORT="50001"
OUT_RULE="rule-outbound"        # outbound rule (SNAT through the frontend IP)

# lb_ip  -> prints the frontend public IP address (empty if it does not exist yet)
lb_ip() { az network public-ip show -g "$RG" -n "$PIP" --query ipAddress --output tsv 2>/dev/null || true; }

# who_answers [count]  -> sends requests to the frontend and prints which VM answered each one
who_answers() {
  local ip n="${1:-10}" i out
  ip="$(lb_ip)"
  if [[ -z "$ip" ]]; then echo "No frontend IP yet (create ${PIP} first)."; return 1; fi
  for ((i = 1; i <= n; i++)); do
    out="$(curl -s --max-time 3 "http://${ip}/" | grep -o 'Served by.*</p>' | sed 's/<[^>]*>//g' || true)"
    echo "${i}. ${out:-(no answer)}"
    sleep 1
  done
}
