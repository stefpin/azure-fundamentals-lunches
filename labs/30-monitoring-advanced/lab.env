# =============================================================================
# Lab 30 · resource names used by the guide and by every script in this folder.
# Load it AFTER the shared settings:
#     source ../common/config.sh
#     source lab.env
# =============================================================================

RG="$(rg_name 30)"                          # rg-lunch30-<suffix>
LAW="log-nusa"                              # Log Analytics workspace: the evidence room
VM="vm-nusa-app"                            # Linux VM that runs the order jobs
ST="stnusalog${SUFFIX}"                     # storage account for product images (globally unique)
CONTAINER="product-images"                  # blob container used by traffic.sh

PLAN="asp-nusa30-${SUFFIX}"                 # Linux App Service plan
# The web app name must be unique across all of Azure. If yours is taken, run
#     export LAB30_APP="app-nusa30-${SUFFIX}x"
# and source this file again.
APP="${LAB30_APP:-app-nusa30-${SUFFIX}}"
APP_SKU="${LAB30_APP_SKU:-B1}"              # Basic B1; see Troubleshooting if your subscription has no quota for it
# Built-in runtime stack. Application Insights autoinstrumentation supports Python 3.9-3.13.
#     az webapp list-runtimes --os-type linux --output table | grep -i python
RUNTIME="${LAB30_RUNTIME:-PYTHON:3.12}"

APPI="appi-nusa-shop"                       # Application Insights (workspace-based)
DCR="dcr-linux-nusa"                        # data collection rule for Linux VMs
DCR_ASSOC="dcra-vm-nusa-app"                # association between the VM and the DCR
DIAG="diag-blob-to-log-nusa"                # diagnostic setting on the blob service
WEBTEST="avail-nusa-health"                 # standard availability test
ALERT="alert-slow-checkout"                 # log search alert
AG="ag-nusa-oncall"                         # action group (only when ALERT_EMAIL is set)

OUT_DIR="${HOME}/lab30-out"                 # generated files (DCR JSON, zip, traffic scratch), outside the repo
